# TiDB Cloud Serverless
TIDB_HOST=gateway01.ap-southeast-1.prod.alicloud.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_tidb_user
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=diet-record
TIDB_CA_PATH=/etc/ssl/cert.pem

# WeChat Mini Program
WECHAT_APPID=wxc5dc80e3116ed628
WECHAT_SECRET=your_wechat_secret_here

# JWT
JWT_SECRET=change-me-to-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30

# LLM (OpenAI-compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key
LLM_MODEL=gpt-4o

# Embedding (本地模型路径，留空自动从 HuggingFace 下载)
BGE_MODEL_PATH=data/bge-small-zh-v1.5
