/* 饮食助手 — 有机温暖风格 */

/* 颜色变量定义 (rpx-based, 小程序无 CSS 变量，直接硬编码) */
/* 主色调: sage green #6b9b6e 替代 WeChat 绿 */
/* 背景: #faf8f5 暖米白 */
/* 强调: #c4965c 蜂蜜金 */

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #faf8f5;
}

/* ── 顶部热量栏 ── */
.today-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  background: linear-gradient(135deg, #6b9b6e 0%, #5a8c5d 100%);
  flex-shrink: 0;
}
.today-label {
  color: rgba(255,255,255,0.8);
  font-size: 24rpx;
}
.today-kcal {
  color: #fff;
  font-weight: 700;
  margin: 0 16rpx;
  font-size: 28rpx;
  letter-spacing: 1rpx;
}
.today-macros {
  color: rgba(255,255,255,0.7);
  font-size: 22rpx;
}

/* ── 消息列表 ── */
.chat-list {
  flex: 1;
  padding: 20rpx 24rpx;
  overflow-y: auto;
}

/* ── 消息气泡通用 ── */
.msg-self {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 20rpx;
}

.msg-bot {
  display: flex;
  justify-content: flex-start;
  margin-bottom: 20rpx;
}

.bubble {
  max-width: 82%;
  padding: 20rpx 26rpx;
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-all;
  position: relative;
}

/* 用户气泡 — 深色 sage */
.bubble.self {
  background: linear-gradient(135deg, #5a8c5d 0%, #4a7a4d 100%);
  color: #fff;
  border-radius: 24rpx 24rpx 8rpx 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(107,155,110,0.25);
}

/* Agent 气泡 — 纸白卡片感 */
.bubble.bot {
  background: #fff;
  color: #2c2c2c;
  border-radius: 8rpx 24rpx 24rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04), 0 1rpx 3rpx rgba(0,0,0,0.03);
}

/* 拒绝消息 — 柔和暖红 */
.bubble.refuse {
  background: #fef8f6;
  color: #c4664a;
  border-radius: 8rpx 24rpx 24rpx 24rpx;
  border-left: 4rpx solid #e8c4b8;
  box-shadow: 0 2rpx 10rpx rgba(196,102,74,0.06);
}

/* ── 卡片通用 ── */
.confirm-card,
.summary-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  max-width: 90%;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05), 0 1rpx 4rpx rgba(0,0,0,0.03);
}

.card-title {
  font-size: 26rpx;
  color: #4a4a4a;
  margin-bottom: 18rpx;
  font-weight: 500;
}

.card-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f2f0ec;
  font-size: 26rpx;
}

.card-food {
  color: #2c2c2c;
}

.card-amount {
  color: #b0ada6;
  font-size: 22rpx;
  margin-left: 6rpx;
}

.card-kcal {
  color: #c4965c;
  font-weight: 600;
  font-size: 24rpx;
}

.card-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed #e8e5e0;
  font-size: 26rpx;
  color: #2c2c2c;
}

.card-total-kcal {
  color: #c4965c;
  font-weight: 700;
  font-size: 32rpx;
}

.card-macros {
  font-size: 24rpx;
  color: #b0ada6;
  margin-top: 8rpx;
}

.card-divider {
  height: 2rpx;
  background: #f2f0ec;
  margin: 18rpx 0;
}

/* 确认/修改按钮 */
.card-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.btn-confirm {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  background: linear-gradient(135deg, #6b9b6e 0%, #5a8c5d 100%);
  color: #fff;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(107,155,110,0.2);
  transition: transform 0.1s, box-shadow 0.1s;
}

.btn-confirm:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 6rpx rgba(107,155,110,0.15);
}

.btn-edit {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  background: #f5f3ef;
  color: #8c8c8c;
  border-radius: 14rpx;
  font-size: 28rpx;
  transition: background 0.1s;
}

.btn-edit:active {
  background: #ebe7e1;
}

/* ── 底部输入栏 ── */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #ede9e2;
  gap: 14rpx;
}

.btn-voice {
  font-size: 40rpx;
  line-height: 1;
  min-width: 48rpx;
  text-align: center;
  opacity: 0.5;
}

.input-wrap {
  flex: 1;
}

.msg-input {
  background: #f5f3ef;
  border-radius: 28rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
  height: 72rpx;
  color: #2c2c2c;
}

.btn-send {
  font-size: 28rpx;
  color: #6b9b6e;
  font-weight: 600;
  padding: 10rpx 18rpx;
}

/* ── 调试面板 ── */
.debug-panel {
  background: #1a1a2e;
  padding: 8rpx 16rpx;
  border-bottom: 2rpx solid #333;
}
.debug-panel.collapsed {
  padding: 6rpx 16rpx;
}

.debug-line {
  font-size: 20rpx;
  color: #0f0;
  font-family: monospace;
  line-height: 1.6;
}

.debug-collapsed {
  display: flex;
  justify-content: center;
}
.debug-collapsed-text {
  font-size: 20rpx;
  color: #0f0;
  opacity: 0.5;
  font-family: monospace;
}

/* ── 语音模式（暂未启用，保留样式） ── */
.voice-zone {
  flex: 1;
  background: #f5f3ef;
  border-radius: 28rpx;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #6b9b6e;
  font-weight: 600;
  user-select: none;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.voice-zone:active {
  background: #ebe7e1;
  transform: scale(0.98);
}

.voice-zone.recording {
  background: #fef6f4;
  color: #c4664a;
  animation: voicePulse 1.2s ease-in-out infinite;
}

@keyframes voicePulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

.input-bar.voice-mode {
  gap: 12rpx;
  padding: 18rpx 24rpx 28rpx;
}

.recording-bar {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: #fef6f4;
  border-bottom: 1rpx solid #f0d4cc;
  gap: 16rpx;
}

.recording-wave {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  height: 36rpx;
}

.wave-bar {
  width: 6rpx;
  background: #c4664a;
  border-radius: 3rpx;
  animation: wave 0.8s ease-in-out infinite;
}

.wave-bar:nth-child(1) { height: 16rpx; animation-delay: 0s; }
.wave-bar:nth-child(2) { height: 32rpx; animation-delay: 0.2s; }
.wave-bar:nth-child(3) { height: 24rpx; animation-delay: 0.4s; }
.wave-bar:nth-child(4) { height: 20rpx; animation-delay: 0.3s; }

@keyframes wave {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 1; }
}

.recording-text {
  flex: 1;
  font-size: 26rpx;
  color: #c4664a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.recording-hint {
  font-size: 22rpx;
  color: #999;
}

/* ── rich-text markdown 渲染 ── */
.bubble.bot rich-text,
.bubble.refuse rich-text {
  font-size: 28rpx;
  line-height: 1.7;
  user-select: text;
  -webkit-user-select: text;
}

.bubble.bot rich-text table {
  width: 100%;
  border-collapse: collapse;
  margin: 14rpx 0;
}

.bubble.bot rich-text th,
.bubble.bot rich-text td {
  padding: 10rpx 14rpx;
  border: 1rpx solid #ede9e2;
  text-align: left;
  font-size: 24rpx;
}

.bubble.bot rich-text th {
  background: #f5f3ef;
  font-weight: 600;
  color: #6b9b6e;
}

.bubble.bot rich-text ul,
.bubble.bot rich-text ol {
  padding-left: 32rpx;
  margin: 8rpx 0;
}

.bubble.bot rich-text hr {
  border: none;
  border-top: 1rpx solid #ede9e2;
  margin: 18rpx 0;
}

.bubble.bot rich-text h3 {
  font-size: 30rpx;
  font-weight: 600;
  margin: 14rpx 0 8rpx;
}

.bubble.bot rich-text strong {
  font-weight: 600;
  color: #4a7a4d;
}

.bubble.bot rich-text em {
  font-style: italic;
}

.bubble.bot rich-text code {
  background: #f5f3ef;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  font-size: 24rpx;
}

.bubble.bot rich-text p {
  margin: 6rpx 0;
}
