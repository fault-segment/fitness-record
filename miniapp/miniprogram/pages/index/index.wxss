.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

/* 消息列表 */
.chat-list {
  flex: 1;
  padding: 12rpx 20rpx;
  overflow-y: auto;
}

/* 消息气泡 */
.msg-self {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 16rpx;
}

.msg-bot {
  display: flex;
  justify-content: flex-start;
  margin-bottom: 16rpx;
}

.bubble {
  max-width: 85%;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

.bubble.self {
  background: #07c160;
  color: #fff;
  border-radius: 20rpx 20rpx 4rpx 20rpx;
}

.bubble.bot {
  background: #fff;
  color: #333;
  border-radius: 4rpx 20rpx 20rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.bubble.refuse {
  background: #fff3f3;
  color: #e74c3c;
  border-radius: 4rpx 20rpx 20rpx 20rpx;
}

/* 确认卡片 + 汇总卡片 */
.confirm-card,
.summary-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  max-width: 90%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.card-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 26rpx;
}

.card-food {
  color: #333;
}

.card-amount {
  color: #999;
  font-size: 22rpx;
}

.card-kcal {
  color: #07c160;
  font-weight: bold;
}

.card-total {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #ddd;
  font-size: 26rpx;
}

.card-total-kcal {
  color: #07c160;
  font-weight: bold;
  font-size: 30rpx;
}

.card-macros {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.card-divider {
  height: 1rpx;
  background: #eee;
  margin: 16rpx 0;
}

.card-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.btn-confirm {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.btn-edit {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  background: #f0f0f0;
  color: #666;
  border-radius: 12rpx;
  font-size: 26rpx;
}

/* 底部输入栏 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 14rpx 20rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  gap: 16rpx;
}

.btn-voice {
  font-size: 44rpx;
  line-height: 1;
}

.input-wrap {
  flex: 1;
}

.msg-input {
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
  height: 70rpx;
}

.btn-send {
  font-size: 26rpx;
  color: #07c160;
  padding: 10rpx 16rpx;
}
