<!-- 饮食助手 — 纯对话界面 -->
<view class="page">
  <!-- 调试面板 -->
  <view wx:if="{{debugLog.length > 0 && isDev}}" class="debug-panel {{debugExpanded ? '' : 'collapsed'}}" bindtap="toggleDebug">
    <block wx:if="{{debugExpanded}}">
      <view wx:for="{{debugLog}}" wx:key="index" class="debug-line">{{item}}</view>
    </block>
    <view wx:if="{{!debugExpanded}}" class="debug-collapsed">
      <text class="debug-collapsed-text">Debug ({{debugLog.length}})</text>
    </view>
  </view>

  <!-- 今日热量顶部栏 -->
  <view class="today-bar" wx:if="{{todaySummary.kcal > 0}}">
    <text class="today-label">今日摄入</text>
    <text class="today-kcal">{{todaySummary.kcal}} kcal</text>
    <text class="today-macros">蛋白{{todaySummary.protein}}g 碳水{{todaySummary.carbs}}g 脂肪{{todaySummary.fat}}g</text>
  </view>

  <scroll-view
    class="chat-list"
    scroll-y
    scroll-top="{{scrollTop}}"
    scroll-with-animation
  >
    <view class="chat-inner">
      <block wx:for="{{messages}}" wx:key="index">
      <!-- Agent 消息 -->
      <view wx:if="{{item.role === 'agent'}}" class="msg-bot">
        <!-- 普通文本 — markdown 渲染 -->
        <view wx:if="{{item.type === 'text'}}" class="bubble bot">
          <rich-text nodes="{{item.contentHtml}}" mode="web"></rich-text>
        </view>

        <!-- 确认卡片 -->
        <view wx:elif="{{item.type === 'card'}}" class="card confirm-card">
          <view class="card-title">帮你整理好了，确认一下：</view>
          <view wx:for="{{item.foods}}" wx:for-item="food" wx:key="*this" class="card-row">
            <text class="card-food">{{food.name}} <text class="card-amount">~{{food.amount}}</text></text>
            <text class="card-kcal">{{food.kcal}} kcal</text>
          </view>
          <view class="card-total">
            <text>合计</text>
            <text class="card-total-kcal">{{item.totals.kcal}} kcal</text>
          </view>
          <view class="card-macros" wx:if="{{item.totals.protein}}">
            <text>蛋白质 {{item.totals.protein}}g | 碳水 {{item.totals.carbs}}g | 脂肪 {{item.totals.fat}}g</text>
          </view>
          <view class="card-actions">
            <view class="btn-confirm" data-index="{{index}}" bindtap="onConfirm">确认</view>
            <view class="btn-edit" data-index="{{index}}" bindtap="onEditCard">修改</view>
          </view>
        </view>

        <!-- 汇总卡片 -->
        <view wx:elif="{{item.type === 'summary'}}" class="card summary-card">
          <view class="card-title">{{item.content}}</view>
          <view class="card-total">
            <text>热量</text>
            <text class="card-total-kcal">{{item.totals.kcal}} kcal</text>
          </view>
          <view class="card-macros" wx:if="{{item.totals.protein}}">
            <text>蛋白质 {{item.totals.protein}}g | 碳水 {{item.totals.carbs}}g | 脂肪 {{item.totals.fat}}g</text>
          </view>
          <!-- 按餐次分组 -->
          <block wx:if="{{item.meals && item.meals.length > 0}}">
            <view wx:for="{{item.meals}}" wx:for-item="meal" wx:key="meal_type" class="meal-group">
              <view class="meal-header">
                <text class="meal-type">{{meal.meal_type}}</text>
                <text class="meal-kcal">{{meal.kcal}} kcal</text>
              </view>
              <view wx:for="{{meal.foods}}" wx:for-item="food" wx:key="*this" class="card-row">
                <text class="card-food">{{food.name}} <text class="card-amount">~{{food.amount}}</text></text>
                <text class="card-kcal">{{food.kcal}} kcal</text>
              </view>
            </view>
          </block>
          <!-- 无 meals 数据时降级显示 flat foods -->
          <block wx:elif="{{item.foods.length > 0}}">
            <view class="card-divider"></view>
            <view wx:for="{{item.foods}}" wx:for-item="food" wx:key="*this" class="card-row">
              <text class="card-food">{{food.name}} <text class="card-amount">~{{food.amount}}</text></text>
              <text class="card-kcal">{{food.kcal}} kcal</text>
            </view>
          </block>
        </view>

        <!-- 拒绝消息 — markdown 渲染 -->
        <view wx:elif="{{item.type === 'refuse'}}" class="bubble refuse">
          <rich-text nodes="{{item.contentHtml}}" mode="web"></rich-text>
        </view>
      </view>

      <!-- 用户消息 -->
      <view wx:if="{{item.role === 'user'}}" class="msg-self">
        <view class="bubble self">
          <text user-select="{{true}}">{{item.content}}</text>
        </view>
      </view>
    </block>
    </view>
  </scroll-view>

  <!-- 录音中提示条 -->
  <view wx:if="{{isRecording}}" class="recording-bar" bindtap="stopVoice">
    <view class="recording-wave">
      <view class="wave-bar"></view>
      <view class="wave-bar"></view>
      <view class="wave-bar"></view>
      <view class="wave-bar"></view>
    </view>
    <text class="recording-text">{{voiceText}}</text>
    <text class="recording-hint">点击停止</text>
  </view>

  <!-- 底部输入栏：文字模式 -->
  <view wx:if="{{!voiceMode}}" class="input-bar">
    <view class="btn-voice" bindtap="toggleVoiceMode">🎤</view>
    <view class="input-wrap">
      <input
        class="msg-input"
        placeholder="说点什么..."
        value="{{inputValue}}"
        bindinput="onInput"
        bindkeyboardheightchange="onKeyboardHeightChange"
        confirm-type="send"
        bindconfirm="sendText"
        adjust-position="{{true}}"
        hold-keyboard="{{true}}"
      />
    </view>
    <view class="btn-send" bindtap="sendText">发送</view>
  </view>

  <!-- 底部输入栏：语音模式 -->
  <view wx:else class="input-bar voice-mode">
    <view class="btn-voice" bindtap="toggleVoiceMode">⌨</view>
    <view
      class="voice-zone {{isRecording ? 'recording' : ''}}"
      bindtap="onVoiceTap"
    >
      <text wx:if="{{!isRecording}}">●  点击 开始录音</text>
      <text wx:else>● 录音中  点击停止</text>
    </view>
  </view>
</view>
